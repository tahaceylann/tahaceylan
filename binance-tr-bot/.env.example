# Binance TR (or any Binance-API-compatible exchange) credentials.
# NEVER commit your real .env file. Copy this to .env and fill in your values.

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Base REST URL of the exchange. Binance TR shut down retail trading in
# 2025 and its old endpoint (www.binance.tr/apiproxy/v3/api) now returns
# the website's HTML instead of JSON - it will NOT work anymore.
# Default here is Binance's global API, which the bot code is fully
# compatible with (same request/response format):
BINANCE_BASE_URL=https://api.binance.com/api/v3

# Trading pair, e.g. BTCUSDT, ETHUSDT, BTCTRY (if still listed on your
# exchange), ETHTRY ...
SYMBOL=BTCUSDT

# Candle interval: 1m,3m,5m,15m,30m,1h,4h,1d ...
INTERVAL=15m

# Strategy parameters
FAST_MA=9
SLOW_MA=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Risk management
QUOTE_ORDER_SIZE=100          # amount of quote currency (e.g. TRY) to spend per buy
MAX_OPEN_POSITIONS=1
STOP_LOSS_PCT=0.02            # 2%
TAKE_PROFIT_PCT=0.04          # 4%
TRAILING_STOP_PCT=0.015       # 1.5% trailing stop once in profit
MAX_DAILY_LOSS_PCT=0.05       # kill-switch: stop trading if daily loss exceeds 5%

# Safety
DRY_RUN=true                  # true = paper trading (no real orders sent)
POLL_SECONDS=30

# Logging / persistence
STATE_FILE=state.json
LOG_LEVEL=INFO

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
