# Binance TR (or any Binance-API-compatible exchange) credentials.
# NEVER commit your real .env file. Copy this to .env and fill in your values.

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Binance TR splits its real API (per https://www.binance.tr/apidocs)
# across two hosts - trading/account calls go to binance.tr, public
# market data (klines etc.) comes from a separate host:
BINANCE_TRADE_BASE_URL=https://www.binance.tr
BINANCE_MARKET_BASE_URL=https://api.binance.me

# Trading pair in Binance TR's own underscore format, e.g. BTC_TRY,
# ETH_TRY, BTC_USDT. (The bot converts it automatically to BTCTRY /
# ETHTRY / BTCUSDT for the market-data endpoints, which need no
# underscore.)
SYMBOL=BTC_TRY

# Candle interval: 1m,3m,5m,15m,30m,1h,4h,1d ...
INTERVAL=15m

# Strategy parameters
FAST_MA=9
SLOW_MA=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Risk management
QUOTE_ORDER_SIZE=100          # amount of quote currency (e.g. TRY) to spend per buy
MAX_OPEN_POSITIONS=1
STOP_LOSS_PCT=0.02            # 2%
TAKE_PROFIT_PCT=0.04          # 4%
TRAILING_STOP_PCT=0.015       # 1.5% trailing stop once in profit
MAX_DAILY_LOSS_PCT=0.05       # kill-switch: stop trading if daily loss exceeds 5%

# Safety
DRY_RUN=true                  # true = paper trading (no real orders sent)
POLL_SECONDS=30

# Logging / persistence
STATE_FILE=state.json
LOG_LEVEL=INFO

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
